# Maintainer: mlm-games
pkgname=opensus
pkgver=0.1.0
pkgrel=1
pkgdesc="OpenSuspect-inspired social deduction game (Bevy)"
arch=('x86_64')
url="https://github.com/mlm-games/opensus"
license=('GPL3')
depends=('alsa-lib' 'libx11' 'libxcb' 'wayland')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::https://github.com/mlm-games/opensus/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cargo build --release
}

package() {
    install -Dm755 target/release/opensus-desktop "$pkgdir/usr/bin/opensus"
}
